<Window x:Class="G321Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G321Studio"
        Title="G321 Studio" Icon="Assets/G321.ico"
        Width="1020" MinWidth="830" MinHeight="650" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Foreground="#F0F2F4" Background="#14171B"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#59DCED"/>
        <SolidColorBrush x:Key="Quiet" Color="#AAB4BF"/>
        <SolidColorBrush x:Key="Surface" Color="#1B1F24"/>
        <SolidColorBrush x:Key="Outline" Color="#343B43"/>
        <SolidColorBrush x:Key="Field" Color="#242A31"/>
        <SolidColorBrush x:Key="Signal" Color="#8A9AA7"/>
        <SolidColorBrush x:Key="Focus" Color="#C5D6DF"/>
        <SolidColorBrush x:Key="Graph" Color="#171A1F"/>
        <Geometry x:Key="BrandMark">
            M49,9 A39,39 0 0 0 49,87 L49,71 A23,23 0 0 1 49,25 Z
            M50,41 H86 V76 H70 V57 H50 Z
        </Geometry>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Quiet}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <DataTemplate x:Key="EndpointName">
            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ButtonFocus" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource Focus}" IsHitTestVisible="False"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="SwitchSurface" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="SwitchFocus" CornerRadius="16" BorderBrush="{StaticResource Focus}"
                                    BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="SwitchTrack" Width="48" Height="24" CornerRadius="12"
                                    Background="#292F36" BorderBrush="#505B66" BorderThickness="1"/>
                            <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="#BBC5CE"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#9AA8B4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#526370"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#80929F"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#F5FDFF"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwitchSurface" Property="Opacity" Value=".77"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchSurface" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Padding="12,8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#313B44"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#3C4853"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MaxDropDownHeight" Value="225"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field" Background="{StaticResource Field}" BorderBrush="{StaticResource Outline}"
                                                CornerRadius="8" BorderThickness="1"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="Background" Value="#303840"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectedValue" IsHitTestVisible="False"
                                Margin="10,0,29,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="10,0,29,0"
                                Foreground="{StaticResource Quiet}" Text="{TemplateBinding Tag}"
                                VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Quiet}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <Border x:Name="FocusOutline" BorderBrush="{StaticResource Focus}" BorderThickness="1"
                                    CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" CornerRadius="8" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectedValue" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SliderRail" TargetType="RepeatButton">
            <Border Background="Transparent">
                <Border x:Name="Rail" Height="3" VerticalAlignment="Center" CornerRadius="1.5"
                        Background="{TemplateBinding Background}"/>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Slider}}" Value="Vertical">
                    <Setter TargetName="Rail" Property="Width" Value="3"/>
                    <Setter TargetName="Rail" Property="Height" Value="Auto"/>
                    <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/>
                    <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="Foreground" Value="{StaticResource Signal}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"
                                                  Background="{TemplateBinding Foreground}" Template="{StaticResource SliderRail}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"
                                                  Background="{StaticResource Outline}" Template="{StaticResource SliderRail}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb" Width="14" Height="14" Cursor="Hand"
                                           Focusable="False" Background="#D2DCE4">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbCore" CornerRadius="7"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="#E2EBF2" BorderThickness="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCore" Property="BorderBrush" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <Border x:Name="SliderFocus" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource Focus}" IsHitTestVisible="False"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1170" Margin="28,20,28,16">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}"
                            BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                        <Viewbox Width="32" Height="32">
                            <Path Data="{StaticResource BrandMark}" Fill="{StaticResource Accent}"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="G321 Studio" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Click="RefreshClicked"
                        AutomationProperties.Name="{local:Text UiRefreshDevices}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 13 3 L 13 7 L 9 7 M 12.7 6.7 A 5.2 5.2 0 1 0 13 10"
                              Stroke="{StaticResource Quiet}" StrokeThickness="1.5"
                              Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{local:Text UiRefreshDevices}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.08*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto" MinHeight="56"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Text UiAudioOutput}" Height="36" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Top" Padding="0,8,0,0"/>
                        <ComboBox Grid.Row="1" x:Name="OutputChoice" Tag="{local:Text UiG321Unavailable}"
                                      Margin="0,0,12,0" VerticalAlignment="Bottom"
                                      ItemTemplate="{StaticResource EndpointName}"
                                      ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                                      ToolTipService.ShowOnDisabled="True"
                                      AutomationProperties.Name="{local:Text UiG321AudioOutput}"
                                      SelectionChanged="DeviceSelectionChanged"/>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Outline}" BorderThickness="1,0,0,0"
                                Padding="12,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{local:Text UiBattery}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BatteryValue" Text="—" FontSize="20" FontWeight="Medium"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </Grid>
                                <ProgressBar x:Name="BatteryProgress" Maximum="100" Height="4" Margin="0,4,0,0"
                                             Visibility="Hidden" Focusable="False" AutomationProperties.Name="{local:Text UiG321BatteryPercentage}"
                                             Background="{StaticResource Outline}" Foreground="{StaticResource Signal}">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                        HorizontalAlignment="Left" CornerRadius="2"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                                <TextBlock x:Name="BatteryDetail" Text="{local:Text UiCheckingBattery}" Style="{StaticResource Caption}"
                                           FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="MonitorSwitchState" Style="{StaticResource Caption}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ToggleButton x:Name="MonitorSwitch" Style="{StaticResource Switch}"
                                              Checked="ToggleMonitor" Unchecked="ToggleMonitor"
                                              AutomationProperties.Name="{local:Text UiSidetone}" ToolTip="{local:Text UiSidetoneToggleHelp}"/>
                            </StackPanel>
                            <TextBlock Text="{local:Text UiSidetone}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{local:Text UiMicrophone}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MicChoice" Tag="{local:Text UiMicrophoneUnavailable}"
                                          ItemTemplate="{StaticResource EndpointName}"
                                          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                                          ToolTipService.ShowOnDisabled="True"
                                          AutomationProperties.Name="{local:Text UiG321Microphone}"
                                          SelectionChanged="DeviceSelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <TextBlock x:Name="MonitorValue" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                               Margin="4,0,0,0" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{local:Text UiVolume}" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <Slider x:Name="MonitorSlider" Height="36" Minimum="0" Maximum="300" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="MonitorVolumeChanged"
                                        AutomationProperties.Name="{local:Text UiSidetoneVolumePercentage}"
                                        AutomationProperties.HelpText="{local:Text RtSidetoneVolumeIndependence}"
                                        ToolTip="{local:Text RtSidetoneVolumeIndependence}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="MonitorStatus" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Text UiEqualizer}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{local:Text UiPreset}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PresetChoice" AutomationProperties.Name="{local:Text UiEqualizerPreset}"
                                      SelectionChanged="PresetChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                            <TextBlock x:Name="EqSwitchState" Style="{StaticResource Caption}" Width="72" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ToggleButton x:Name="EqSwitch" Style="{StaticResource Switch}"
                                          Checked="ToggleEq" Unchecked="ToggleEq"
                                          AutomationProperties.Name="{local:Text UiEqualizer}" ToolTip="{local:Text UiEqualizerToggleHelp}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource Graph}" BorderBrush="{StaticResource Outline}"
                            BorderThickness="1" CornerRadius="8" Padding="8,4,8,12">
                        <StackPanel>
                            <local:EqualizerGraph x:Name="EqGraph" Height="176"/>
                            <UniformGrid x:Name="Bands" Rows="1" Columns="10" Margin="44,0,8,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <DockPanel>
                                <TextBlock x:Name="PreampValue" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                           TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="{local:Text UiPreamp}" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider x:Name="PreampSlider" Height="36" Minimum="-18" Maximum="12" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="EqualizerChanged"
                                    AutomationProperties.Name="{local:Text UiPreampDecibels}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{local:Text UiWindowsSoundSettings}" VerticalAlignment="Bottom" Click="OpenSoundSettings"/>
                    </Grid>
                    <TextBlock x:Name="EqStatus" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
