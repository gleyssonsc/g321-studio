<Window x:Class="G321Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G321Studio"
        Title="G321 Studio" Icon="Assets/G321.ico"
        Width="1020" MinWidth="830" MinHeight="650" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Foreground="#EDF4FA"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.82,1">
            <GradientStop Color="#131F2A" Offset="0"/>
            <GradientStop Color="#0E151E" Offset=".44"/>
            <GradientStop Color="#0C1119" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#61E4F7"/>
        <SolidColorBrush x:Key="Quiet" Color="#A1B2C4"/>
        <SolidColorBrush x:Key="Surface" Color="#15202D"/>
        <SolidColorBrush x:Key="Outline" Color="#314256"/>
        <SolidColorBrush x:Key="Field" Color="#1D2A39"/>
        <LinearGradientBrush x:Key="Signal" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#0595FF" Offset="0"/>
            <GradientStop Color="#00E0F2" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Graph" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#111F2B" Offset="0"/>
            <GradientStop Color="#101923" Offset=".6"/>
            <GradientStop Color="#14202D" Offset="1"/>
        </LinearGradientBrush>
        <Geometry x:Key="BrandMark">
            M49,9 A39,39 0 0 0 49,87 L49,71 A23,23 0 0 1 49,25 Z
            M50,41 H86 V76 H70 V57 H50 Z
        </Geometry>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Quiet}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <DataTemplate x:Key="EndpointName">
            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ButtonFocus" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{StaticResource Accent}" IsHitTestVisible="False"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="SwitchSurface" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="SwitchFocus" CornerRadius="17" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="SwitchTrack" Width="50" Height="27" CornerRadius="13.5"
                                    Background="#2A384B" BorderBrush="#465A71" BorderThickness="1"/>
                            <Ellipse x:Name="SwitchThumb" Width="19" Height="19" Fill="#D3DEEB"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#8BA3B9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource Signal}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#76ECF9"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#F5FDFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="23" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwitchSurface" Property="Opacity" Value=".77"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchSurface" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Padding="10,8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#20394B"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#2A4659"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MaxDropDownHeight" Value="225"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field" Background="{StaticResource Field}" BorderBrush="{StaticResource Outline}"
                                                CornerRadius="7" BorderThickness="1"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="Background" Value="#26394A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectedValue" IsHitTestVisible="False"
                                Margin="10,0,29,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="10,0,29,0"
                                Foreground="{StaticResource Quiet}" Text="{TemplateBinding Tag}"
                                VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Quiet}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <Border x:Name="FocusOutline" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    CornerRadius="7" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" CornerRadius="7" Margin="0,3,0,0">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectedValue" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SliderRail" TargetType="RepeatButton">
            <Border Background="Transparent">
                <Border x:Name="Rail" Height="3" VerticalAlignment="Center" CornerRadius="1.5"
                        Background="{TemplateBinding Background}"/>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Slider}}" Value="Vertical">
                    <Setter TargetName="Rail" Property="Width" Value="3"/>
                    <Setter TargetName="Rail" Property="Height" Value="Auto"/>
                    <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/>
                    <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="Foreground" Value="{StaticResource Signal}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"
                                                  Background="{TemplateBinding Foreground}" Template="{StaticResource SliderRail}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"
                                                  Background="#43566B" Template="{StaticResource SliderRail}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb" Width="14" Height="14" Cursor="Hand"
                                           Focusable="False" Background="{StaticResource Signal}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbCore" CornerRadius="7"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="#8CEBFA" BorderThickness="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCore" Property="BorderBrush" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <Border x:Name="SliderFocus" CornerRadius="5" BorderThickness="1"
                                    BorderBrush="{StaticResource Accent}" IsHitTestVisible="False"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1170" Margin="28,19,28,14">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="55" Height="55" Background="#182837" BorderBrush="#39556A"
                            BorderThickness="1" CornerRadius="13" Margin="0,0,13,0">
                        <Viewbox Width="37" Height="37">
                            <Path Data="{StaticResource BrandMark}" Fill="{StaticResource Signal}"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="G321 Studio" FontSize="29" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Click="RefreshClicked"
                        AutomationProperties.Name="Atualizar dispositivos">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 13 3 L 13 7 L 9 7 M 12.7 6.7 A 5.2 5.2 0 1 0 13 10"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.4"
                              Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Atualizar dispositivos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="148"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="Saída de áudio" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="OutputChoice" Tag="G321 indisponível"
                                      ItemTemplate="{StaticResource EndpointName}"
                                      ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                                      ToolTipService.ShowOnDisabled="True"
                                      AutomationProperties.Name="Saída de áudio do G321"
                                      SelectionChanged="DeviceSelectionChanged"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{StaticResource Outline}" BorderThickness="1,0,0,0"
                                Padding="13,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="Bateria" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BatteryValue" Text="—" FontSize="22" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{StaticResource Accent}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </Grid>
                                <ProgressBar x:Name="BatteryProgress" Maximum="100" Height="5" Margin="0,4,0,0"
                                             Visibility="Hidden" Focusable="False" AutomationProperties.Name="Porcentagem da bateria do G321"
                                             Background="{StaticResource Outline}" Foreground="{StaticResource Signal}">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                        HorizontalAlignment="Left" CornerRadius="2.5"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                                <TextBlock x:Name="BatteryDetail" Text="Consultando…" Style="{StaticResource Caption}"
                                           FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,5">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="MonitorSwitchState" Style="{StaticResource Caption}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <ToggleButton x:Name="MonitorSwitch" Style="{StaticResource Switch}" Height="30"
                                              Checked="ToggleMonitor" Unchecked="ToggleMonitor"
                                              AutomationProperties.Name="Retorno de voz" ToolTip="Ativar ou desativar o retorno de voz"/>
                            </StackPanel>
                            <TextBlock Text="Retorno de voz" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Microfone" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MicChoice" Tag="Microfone indisponível"
                                          ItemTemplate="{StaticResource EndpointName}"
                                          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                                          ToolTipService.ShowOnDisabled="True"
                                          AutomationProperties.Name="Microfone do G321"
                                          SelectionChanged="DeviceSelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <TextBlock x:Name="MonitorValue" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" Margin="5,0,0,0" TextAlignment="Right"/>
                                    <TextBlock Text="Volume" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <Slider x:Name="MonitorSlider" Height="36" Minimum="0" Maximum="300" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="MonitorVolumeChanged"
                                        AutomationProperties.Name="Volume do retorno em porcentagem"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="MonitorStatus" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="182"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Equalizador" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Preset" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PresetChoice" AutomationProperties.Name="Preset do equalizador"
                                      SelectionChanged="PresetChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="19,0,0,0">
                            <TextBlock x:Name="EqSwitchState" Style="{StaticResource Caption}" Width="72" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ToggleButton x:Name="EqSwitch" Style="{StaticResource Switch}"
                                          Checked="ToggleEq" Unchecked="ToggleEq"
                                          AutomationProperties.Name="Equalizador" ToolTip="Ativar ou desativar o equalizador"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource Graph}" BorderBrush="{StaticResource Outline}"
                            BorderThickness="1" CornerRadius="12" Padding="8,3,8,10">
                        <StackPanel>
                            <local:EqualizerGraph x:Name="EqGraph" Height="173"/>
                            <UniformGrid x:Name="Bands" Rows="1" Columns="10" Margin="44,0,8,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <DockPanel>
                                <TextBlock x:Name="PreampValue" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" TextAlignment="Right"/>
                                <TextBlock Text="Pré-amplificador" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider x:Name="PreampSlider" Height="36" Minimum="-18" Maximum="0" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="EqualizerChanged"
                                    AutomationProperties.Name="Pré-amplificador em decibéis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Som do Windows" VerticalAlignment="Bottom" Click="OpenSoundSettings"/>
                    </Grid>
                    <TextBlock x:Name="EqStatus" Style="{StaticResource Caption}" Margin="0,9,0,0"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
